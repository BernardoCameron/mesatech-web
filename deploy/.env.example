# Copia a ".env" en esta carpeta. NUNCA subas ".env" ni los certificados.

DOMINIO_WEB=mesatech.bcameron.dev
DOMINIO_API=mesatech-api.bcameron.dev
# URL de invocacion del API Gateway (el front la usa como NEXT_PUBLIC_API_URL)
API_URL=https://sbl7swxiye.execute-api.us-east-1.amazonaws.com

# Microsoft Entra ID
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# App Registration del front (SPA)
AZURE_WEB_CLIENT_ID=00000000-0000-0000-0000-000000000000
# App Registration de la API (mesatech-api) y su scope
AZURE_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# IP privada de las EC2 de los microservicios (ver INFRA.md)
IP_SOLICITUDES=172.31.18.160
IP_CATALOGO=172.31.30.26
