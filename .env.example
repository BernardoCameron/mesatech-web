# Copia a ".env.local" para correr con "npm run dev". NUNCA subas ".env.local".

# URL del BFF (el navegador llama a esta direccion)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Login: "prueba" (3 usuarios fijos, BFF con perfil sinauth) o "entra" (Microsoft Entra ID)
NEXT_PUBLIC_AUTH=prueba

# Solo con NEXT_PUBLIC_AUTH=entra (valores de la App Registration del front y de mesatech-api)
NEXT_PUBLIC_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_AZURE_WEB_CLIENT_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
# Si se omite, usa el origen de la pagina
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000
